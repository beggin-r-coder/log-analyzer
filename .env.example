# Copy to .env and fill in. .env is git-ignored: never commit real secrets.

# Login for the dashboard (required for docker compose)
APP_USERNAME=admin
APP_PASSWORD=change-me-to-a-long-random-password

# Google Gemini (AI Studio) key for AI error analysis; leave empty for offline NLP mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Branding shown in the dashboard and PDF report
BRAND_NAME=NovaBank

# true when the site is served over HTTPS (any real host); false for http://localhost
SECURE_COOKIES=false
