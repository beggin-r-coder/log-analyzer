# Copy to .env and fill in. .env is git-ignored: never commit real secrets.

# Demo mode: adds an 'Explore as guest' read-only login and a guided tour
DEMO_MODE=true

# Admin login for the dashboard (required for docker compose)
APP_USERNAME=admin
APP_PASSWORD=change-me-to-a-long-random-password

# Error analysis uses the built-in NLP engine. Set AI_ENABLED=true and a Gemini key to use Gemini instead.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Branding shown in the dashboard and PDF report
BRAND_NAME=NovaBank

# true when the site is served over HTTPS (any real host); false for http://localhost
SECURE_COOKIES=false
